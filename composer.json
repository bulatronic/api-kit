{
    "name": "bulatronic/api-kit",
    "type": "symfony-bundle",
    "license": "MIT",
    "description": "Lightweight Symfony bundle for building REST APIs with DTO-first validation, standardized responses, and thin controllers",
    "keywords": ["symfony", "rest", "api", "dto", "validation", "bundle"],
    "authors": [
        {
            "name": "Bulat Timerbaev",
            "email": "bulat.coder@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/validator": "7.4.*"
    },
    "require-dev": {
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/orm": "^3.6.2",
        "friendsofphp/php-cs-fixer": "^3.94.2",
        "phpstan/phpstan": "^2.1.40",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpstan/phpstan-symfony": "^2.0.15",
        "phpunit/phpunit": "^13.0.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.10",
        "symfony/phpunit-bridge": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "Required if you want to use EntityExistsValidator (^2.14)",
        "doctrine/orm": "Required if you want to use EntityExistsValidator (^3.4)"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "ApiKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApiKit\\Tests\\": "tests/",
            "App\\": "tests/app/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
