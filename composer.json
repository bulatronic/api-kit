{
    "name": "bulatronic/api-kit",
    "type": "symfony-bundle",
    "license": "MIT",
    "description": "Lightweight Symfony bundle for building REST APIs with DTO-first validation, standardized responses, and thin controllers",
    "keywords": ["symfony", "rest", "api", "dto", "validation", "bundle"],
    "authors": [
        {
            "name": "Bulat Timerbaev",
            "email": "bulat.coder@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "symfony/event-dispatcher": "^7.4|^8.1.1",
        "symfony/framework-bundle": "^7.4|^8.1.1",
        "symfony/http-foundation": "^7.4|^8.1.1",
        "symfony/serializer": "^7.4|^8.1.1",
        "symfony/validator": "^7.4|~8.0.14"
    },
    "require-dev": {
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/orm": "^3.6.7",
        "friendsofphp/php-cs-fixer": "^3.95.15",
        "nelmio/api-doc-bundle": "^5.10.3",
        "phpstan/phpstan": "^2.2.5",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^13.2.4",
        "symfony/browser-kit": "^7.4|^8.1.1",
        "symfony/console": "^7.4|^8.1.1",
        "symfony/css-selector": "^7.4|^8.1",
        "symfony/dotenv": "^7.4|^8.1",
        "symfony/flex": "^2.11",
        "symfony/phpunit-bridge": "^7.4|^8.1.1",
        "symfony/runtime": "^7.4|^8.1",
        "symfony/yaml": "^7.4|^8.1.1",
        "zircote/swagger-php": "^6.4"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "Required if you want to use EntityExistsValidator (^2.14)",
        "doctrine/orm": "Required if you want to use EntityExistsValidator (^3.4)",
        "nelmio/api-doc-bundle": "Required at runtime if you use ApiKit\\OpenApi\\Attribute\\* — they reference DTOs via Nelmio\\ApiDocBundle\\Attribute\\Model (tested with ^5.0)",
        "zircote/swagger-php": "Required at runtime if you use ApiKit\\OpenApi\\Attribute\\* — every attribute there extends OpenApi\\Attributes\\Response (tested with ^6.0)"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "ApiKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApiKit\\Tests\\": "tests/",
            "App\\": "tests/app/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.4|^8.0"
        }
    }
}
